## TEMPLATE — Dell, RHEL 8, UEFI boot. Everything below is real,
## directly-editable content — edit this file for that. Only __TOKEN__
## placeholders get substituted per-server by kickstart_gen.sh (hostname,
## network values, LVM filesystem list from the CSV, PNC provisioning
## values). RHEL 9 Dell templates don't exist yet — this pipeline currently
## only builds RHEL 8. There is a separate kickstart-dell-rhel8-legacy.ks.tmpl
## for BIOS/Legacy boot — boot mode and RHEL major version are both picked
## by choosing a template file, not by branching inside one shared file.
## Server: __HOSTNAME__

## --- Package source ---
url --url http://10.8.171.50/PNC/distros/RHEL8.6-x86_64/

lang en_US.UTF-8
keyboard us
skipx

network --bootproto static --ip=__IP__ --netmask=255.255.255.0 --gateway=__GATEWAY__ --nameserver=192.88.246.62 --hostname=__HOSTNAME__ __NETWORK_DEVICE_PART__

## --- Root password ---
## Pre-hashed (openssl passwd -6) — never plaintext, unlike the original
## template which had this in the clear over anonymous HTTP.
rootpw --iscrypted $6$y5xGWWpN7mRTRQuG$V5.qvYvWJcv8QD6V5n.OgB5wFQmlFdFMKGRlSONg98alArX0Hm4beOnBLtglCuGyn3Ry4S1cKoxdnlPyzLScJ1

firewall --service=ssh
timezone --utc EST
services --disabled gpm,sendmail,cups,pcmcia,isdn,rawdevices,hpoj,bluetooth,openibd,avahi-daemon,avahi-dnsconfd,hidd,hplip,pcscd,firewalld

bootloader --location=mbr --boot-drive=sda --append="crashkernel=auto rhgb quiet" --driveorder=/dev/sda
zerombr
ignoredisk --only-use=/dev/sda
clearpart --all --drives=/dev/sda
part /boot --fstype xfs --size=2048
part /boot/efi --fstype efi --size=2048
part pv.13 --size=153600 --grow --ondisk=/dev/sda
part pv.14 --size=81920 --ondisk=/dev/sda
volgroup rootvg --pesize=4096 pv.13
volgroup toolsvg --pesize=4096 pv.14

# Standard rootvg/toolsvg layout — filesystems below this line are generated
# from the CSV (core + extra), plus fixed toolsvg volumes and (RHEL9 only)
# rootvg extras that are NOT configurable from the intake tool.
__LOGVOL_BLOCK__

text
reboot

%packages
@^minimal-environment
kexec-tools
jq
%end

%post
logger "Starting anaconda __HOSTNAME__ postinstall"
exec < /dev/tty3 > /dev/tty3
/usr/bin/chvt 3
(

mkdir -p /root/.ssh
chmod 700 /root/.ssh
# Copying keys
cat << EOF >> /root/.ssh/authorized_keys
#add root keys here that needs to be at the instalation time
from="lean309a.prod.pncint.net,lean311a.prod.pncint.net,lean312a.prod.pncint.net,lean313a.prod.pncint.net,10.6.171.188,10.8.172.57,10.8.172.58,10.6.171.189" ssh-rsa 
from="lean065a.rnd.pncint.net,lean066a.rnd.pncint.net,10.11.204.97,10.11.204.98" ssh-rsa 
EOF
chmod 0600 /root/.ssh/authorized_keys
chown -R root: /root/.ssh
command -v restorecon && restorecon -RvF /root/.ssh || true

systemctl disable firewalld

echo "BUILDSERVER=\"lmrg34ja\"
BUILD_OS=\"RHEL\"
HOSTNAME=\"__HOSTNAME__\"
FINALIPADDR=\"__IP__\"
GATEWAY=\"__GATEWAY__\"
LOCATION=\"__LOCATION__\"
CIDEVICE=\"__CI_DEVICE__\"
###" >/boot/PNC_PROVISION_CONFIG

) >>/root/PNC_PostInstall.log 2>&1

echo "[main]
dns=none" >/etc/NetworkManager/conf.d/90-dns-none.conf

interface=$(udevadm info /sys/class/net/nic | grep ID_NET_NAME_ONBOARD | awk -F= '{print $2}')
cat << EOF > /etc/sysconfig/network-scripts/ifcfg-$interface
BOOTPROTO="none"
IPADDR="__IP__"
NETMASK="255.255.255.0"
GATEWAY="__GATEWAY__"
DOMAIN="__DOMAIN__"
DEVICE=$interface
HWADDR="__MAC__"
ONBOOT=yes
PEERDNS=no
PEERROUTES=no
DEFROUTE=yes
MTU=__MTU__
NAME=$interface
EOF

rm -rf /etc/systemd/network/10-anaconda-ifname-*
fixfiles onboot

cat > /usr/bin/firstboot.sh << 'EOF'
#!/bin/bash
rm -rf /etc/resolv.conf
echo "search __DOMAIN__ pncint.net
nameserver 192.88.246.200
nameserver 192.88.246.203
options timeout:2" >> /etc/resolv.conf
systemctl disable firstboot.service
rm -rf /etc/systemd/system/firstboot.service
reboot
EOF
chmod +x /usr/bin/firstboot.sh

cat > /etc/systemd/system/firstboot.service << 'EOF'
[Unit]
Description=First boot config
DefaultDependencies=no
Conflicts=shutdown.target
Wants=network-online.target
After=network.target network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/sleep 60
ExecStart=/usr/bin/firstboot.sh
TimeoutSec=0

[Install]
WantedBy=sysinit.target
EOF
systemctl enable firstboot.service

grub2-mkconfig -o /boot/grub2/grub.cfg
sync
exit 0
%end
