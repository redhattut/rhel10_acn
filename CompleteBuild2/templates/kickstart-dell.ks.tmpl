## TEMPLATE — Dell. Partitioning, packages, and structure below are real,
## editable content — edit this file directly for that. Only the specific
## __TOKEN__ placeholders get substituted per-server by kickstart_gen.sh
## (hostname, network, root password hash, boot-mode-specific bootloader
## line, LVM filesystem list from the CSV, PNC provisioning config).
## Server: __HOSTNAME__

## --- Package source ---
## Historic: static HTTP mirror of the install tree. This is the one line
## that needs to change when the Satellite migration proceeds — see
## lib/post_install.sh:register_satellite() for where subscription-manager
## registration would replace/augment this.
url --url __REPO_URL__

lang en_US.UTF-8
keyboard us
skipx

network __NETWORK_LINE__

## --- Root password ---
## FIX: the original template embedded a plaintext root password directly in
## a file served over anonymous HTTP. This build injects a pre-hashed
## password from $ROOTPW_HASH (set by kickstart_gen.sh from the environment,
## never written to disk in plaintext).
rootpw --iscrypted __ROOTPW_HASH__

firewall --service=ssh
timezone --utc EST
services --disabled gpm,sendmail,cups,pcmcia,isdn,rawdevices,hpoj,bluetooth,openibd,avahi-daemon,avahi-dnsconfd,hidd,hplip,pcscd,firewalld

__BOOTLOADER_LINE__
zerombr
ignoredisk --only-use=/dev/sda
clearpart --all --drives=/dev/sda
part /boot --fstype xfs --size=2048
__BOOT_EFI_LINE__
part pv.13 --size=153600 --grow --ondisk=/dev/sda
part pv.14 --size=81920 --ondisk=/dev/sda
volgroup rootvg --pesize=4096 pv.13
volgroup toolsvg --pesize=4096 pv.14

# Standard rootvg/toolsvg layout — filesystems below this line are generated
# from the CSV (core + extra), plus fixed toolsvg volumes and (RHEL9 only)
# rootvg extras that are NOT configurable from the intake tool.
__LOGVOL_BLOCK__

text
reboot

%packages
@^minimal-environment
kexec-tools
jq
%end

%post
logger "Starting anaconda __HOSTNAME__ postinstall"
exec < /dev/tty3 > /dev/tty3
/usr/bin/chvt 3
(

mkdir -p ~root/.ssh
cat << 'EOF' >> ~root/.ssh/authorized_keys
## EDIT ME: add real authorized_keys entries below, one per line, e.g.:
## from="lean301a.prod.pncint.net,..." ssh-rsa AAAAB3NzaC1yc2E...
EOF
chmod 0700 ~root/.ssh
chmod 0600 ~root/.ssh/authorized_keys
chown -R root: ~root/.ssh
command -v restorecon && restorecon -RvF ~root/.ssh || true

systemctl disable firewalld

__PNC_PROVISION_CONFIG_BLOCK__

) >>/root/PNC_PostInstall.log 2>&1

echo "[main]
dns=none" >/etc/NetworkManager/conf.d/90-dns-none.conf

interface=$(udevadm info /sys/class/net/nic | grep ID_NET_NAME_ONBOARD | awk -F= '{print $2}')
cat << EOF > /etc/sysconfig/network-scripts/ifcfg-$interface
BOOTPROTO="none"
IPADDR="__IP__"
NETMASK="255.255.255.0"
GATEWAY="__GATEWAY__"
DOMAIN="__DOMAIN__"
DEVICE=$interface
HWADDR="__MAC__"
ONBOOT=yes
PEERDNS=no
PEERROUTES=no
DEFROUTE=yes
MTU=__MTU__
NAME=$interface
EOF

rm -rf /etc/systemd/network/10-anaconda-ifname-*
fixfiles onboot

cat > /usr/bin/firstboot.sh << 'EOF'
#!/bin/bash
rm -rf /etc/resolv.conf
echo "search __DOMAIN__ pncint.net
nameserver 192.88.246.200
nameserver 192.88.246.203
options timeout:2" >> /etc/resolv.conf
systemctl disable firstboot.service
rm -rf /etc/systemd/system/firstboot.service
reboot
EOF
chmod +x /usr/bin/firstboot.sh

cat > /etc/systemd/system/firstboot.service << 'EOF'
[Unit]
Description=First boot config
DefaultDependencies=no
Conflicts=shutdown.target
Wants=network-online.target
After=network.target network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/sleep 60
ExecStart=/usr/bin/firstboot.sh
TimeoutSec=0

[Install]
WantedBy=sysinit.target
EOF
systemctl enable firstboot.service

grub2-mkconfig -o /boot/grub2/grub.cfg
sync
exit 0
%end
