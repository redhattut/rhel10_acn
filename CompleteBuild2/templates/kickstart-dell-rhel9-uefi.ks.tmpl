%post
logger "Starting anaconda __HOSTNAME__ postinstall"
exec < /dev/tty3 > /dev/tty3
/usr/bin/chvt 3
(

mkdir -p /root/.ssh
chmod 0700 /root/.ssh
# Copying keys
cat << EOF >> /root/.ssh/authorized_keys
#add root keys here that needs to be at the instalation time
from="lean309a.prod.pncint.net,lean311a.prod.pncint.net,lean312a.prod.pncint.net,lean313a.prod.pncint.net,10.6.171.188,10.8.172.57,10.8.172.58,10.6.171.189" ssh-rsa 
from="lean065a.rnd.pncint.net,lean066a.rnd.pncint.net,10.11.204.97,10.11.204.98" ssh-rsa 
EOF
chmod 0600 /root/.ssh/authorized_keys
chown -R root: /root/.ssh
command -v restorecon && restorecon -RvF /root/.ssh || true

systemctl disable firewalld

echo "BUILDSERVER=\"lmrg34ja\"
BUILD_OS=\"RHEL\"
HOSTNAME=\"__HOSTNAME__\"
FINALIPADDR=\"__IP__\"
GATEWAY=\"__GATEWAY__\"
LOCATION=\"__LOCATION__\"
CIDEVICE=\"__CI_DEVICE__\"
###" >/boot/PNC_PROVISION_CONFIG

) >>/root/PNC_PostInstall.log 2>&1

## --- RHEL9-only additions below (not present in the RHEL8 templates) ---

sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/g' /etc/ssh/sshd_config
sed -i 's/#PasswordAuthentication/PasswordAuthentication/g' /etc/ssh/sshd_config
sed -i 's/#PermitEmptyPasswords/PermitEmptyPasswords/g' /etc/ssh/sshd_config
sed -i 's/#UseDNS no/UseDNS yes/g' /etc/ssh/sshd_config
systemctl restart sshd

## Direct resolv.conf write with the full multi-environment search list —
## REPLACES RHEL8's delayed firstboot.service DNS trick (see RHEL8
## templates) rather than running both; the two approaches write the same
## file and doing both would be redundant/contradictory. Confirm this is
## the intended replacement, not an addition alongside firstboot.service.
echo "search prod.pncint.net pncbank.com pncint.net qa.pncint.net uat.pncint.net rnd.pncint.net
nameserver 192.88.246.200
nameserver 192.88.246.203
options timeout:2
###" > /etc/resolv.conf

## *** CONFIRM: static regardless of target environment, or should this
## track something per-server (e.g. LOCATION/CI_DEVICE)? Included exactly
## as given for now. ***
echo "lmrg05ga.rnd.pncint.net" > /etc/yum/vars/buildserver

echo "[main]
dns=none
###" > /etc/NetworkManager/conf.d/90-dns-none.conf

update-crypto-policies --set DEFAULT:SHA1

## Network config persistence — unrelated to the DNS change above, kept
## as-is from the RHEL8 templates. Writes a proper NetworkManager-style
## ifcfg file so the static config anaconda already applied survives
## reboot cleanly instead of relying on the transient
## /etc/systemd/network/10-anaconda-ifname-* files it also removes here.
interface=$(udevadm info /sys/class/net/nic | grep ID_NET_NAME_ONBOARD | awk -F= '{print $2}')
cat << EOF > /etc/sysconfig/network-scripts/ifcfg-$interface
BOOTPROTO="none"
IPADDR="__IP__"
NETMASK="255.255.255.0"
GATEWAY="__GATEWAY__"
DOMAIN="__DOMAIN__"
DEVICE=$interface
HWADDR="__MAC__"
ONBOOT=yes
PEERDNS=no
PEERROUTES=no
DEFROUTE=yes
MTU=__MTU__
NAME=$interface
EOF

rm -rf /etc/systemd/network/10-anaconda-ifname-*
fixfiles onboot

grub2-mkconfig -o /boot/grub2/grub.cfg
sync
exit 0
%end
